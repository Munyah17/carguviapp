# Supabase — local dev: copy values from `supabase start` output.
# Production: Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (optional - deterministic fallback when unset)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Payment provider: mock (default) | paynow | ecocash | zipit
PAYMENT_PROVIDER=mock

# Protects /api/reminders cron route in production
CRON_SECRET=

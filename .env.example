# Supabase — local dev: copy values from `supabase start` output.
# Production: Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this deployment — used for auth email redirect targets
# (confirmation links land on /auth/confirm here, never localhost).
# On Vercel this falls back to VERCEL_URL automatically; set it for production.
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (optional - deterministic fallback when unset)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Payment provider: mock (default) | paynow | ecocash | zipit
PAYMENT_PROVIDER=mock

# Protects /api/reminders cron route in production
CRON_SECRET=
